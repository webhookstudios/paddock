[Desktop Entry]
Type=Application
Name=Paddock
GenericName=Partition Manager
Comment=Create, resize, move, copy, format and check disk partitions
Exec=paddock %F
Icon=io.github.webhookstudios.Paddock
Terminal=false
StartupNotify=true
StartupWMClass=io.github.webhookstudios.Paddock
Categories=System;Settings;GTK;GNOME;
Keywords=slice;sedge;disk;partition;format;resize;usb;drive;gpt;mbr;ext4;ntfs;clone;
