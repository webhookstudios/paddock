<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>webhookstudios</vendor>
  <vendor_url>https://github.com/webhookstudios/slice</vendor_url>
  <action id="io.github.webhookstudios.slice.run">
    <description>Change disks and partitions</description>
    <message>Authentication is required to change disks and partitions</message>
    <icon_name>io.github.webhookstudios.Slice</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/slice/slice-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>
